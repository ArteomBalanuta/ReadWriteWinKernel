<VSTemplate Version="3.0.0" xmlns="http://schemas.microsoft.com/developer/vstemplate/2005" Type="Project">
  <TemplateData>
    <TemplateID>Microsoft.Cpp.Driver.NDISFilter</TemplateID>
    <Name>Filter Driver: NDIS</Name>
    <Description>A project for NDIS filter drivers. Builds Universal drivers by default.</Description>
    <ProjectType>VC</ProjectType>
    <ProjectSubType>
    </ProjectSubType>
    <SortOrder>1000</SortOrder>
    <NumberOfParentCategoriesToRollUp>1</NumberOfParentCategoriesToRollUp>
    <CreateNewFolder>true</CreateNewFolder>
    <DefaultName>ndislwf</DefaultName>
    <ProvideDefaultName>true</ProvideDefaultName>
    <LocationField>Enabled</LocationField>
    <EnableLocationBrowseButton>true</EnableLocationBrowseButton>
    <Icon>__TemplateIcon.ico</Icon>
    <PromptForSaveOnCreation>true</PromptForSaveOnCreation>
    <LanguageTag Value="CPP" />
    <ProjectTypeTag Value="Driver" />
    <PlatformTag Value="Windows" />
  </TemplateData>
  <TemplateContent>
    <Project TargetFileName="ndislwf.vcxproj" File="ndislwf.vcxproj" ReplaceParameters="true">
      <ProjectItem ReplaceParameters="true" TargetFileName="$projectname$.vcxproj.filters">ndislwf.vcxproj.filters</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="$drivername$.inf">netlwf.inf</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="precomp.c">precomp.c</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="device.c">device.c</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="filter.c">filter.c</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="filter.h">filter.h</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="filter.htm">filter.htm</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="filter.rc">filter.rc</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="filteruser.h">filteruser.h</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="flt_dbg.c">flt_dbg.c</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="flt_dbg.h">flt_dbg.h</ProjectItem>
      <ProjectItem ReplaceParameters="true" TargetFileName="precomp.h">precomp.h</ProjectItem>
    </Project>
    <CustomParameters>
      <CustomParameter
          Name="$DriverTemplate_ProjectType$"
          Value="Driver" />
      <CustomParameter
          Name="$DriverTemplate_GUID$"
          Value="{6A28A010-531F-4FA0-9654-2C0E8296D0EE}" />
    </CustomParameters>
  </TemplateContent>
  <WizardExtension>
    <Assembly>Microsoft.DriverKit.DriverWizard, Version=10.0.0.0, Culture=neutral, PublicKeyToken=31bf3856ad364e35</Assembly>
    <FullClassName>Microsoft.DriverKit.DriverWizard.Wizard</FullClassName>
  </WizardExtension>
</VSTemplate>
