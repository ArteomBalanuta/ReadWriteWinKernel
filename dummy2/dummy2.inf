;
; dummy2.inf
;

[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ManufacturerName%
CatalogFile=dummy2.cat
DriverVer=
PnpLockDown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
dummy2.sys  = 1,,

;*****************************************
; Install Section
;*****************************************

[Manufacturer]
%ManufacturerName%=Standard,NT$ARCH$.10.0...16299 ; %13% support introduced in build 16299

[Standard.NT$ARCH$.10.0...16299]
%dummy2.DeviceDesc%=dummy2_Device, USB\VID_vvvv&PID_pppp

[dummy2_Device.NT]
CopyFiles=File_Copy

[File_Copy]
dummy2.sys

[dummy2_Device.NT.HW]
AddReg=dummy2_AddReg

[dummy2_AddReg]
; By default, USBDevice class uses iProduct descriptor to name the device
; Uncomment for this device to use %dummy2.DeviceDesc%
;HKR,,FriendlyName,,%dummy2.DeviceDesc%

;-------------- Service installation
[dummy2_Device.NT.Services]
AddService = dummy2,%SPSVCINST_ASSOCSERVICE%, dummy2_Service_Inst

; -------------- dummy2 driver install sections
[dummy2_Service_Inst]
DisplayName    = %dummy2.SVCDESC%
ServiceType    = 1               ; SERVICE_KERNEL_DRIVER
StartType      = 3               ; SERVICE_DEMAND_START
ErrorControl   = 1               ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\dummy2.sys

[dummy2_Device.NT.Wdf]
KmdfService =  dummy2, dummy2_wdfsect

[dummy2_wdfsect]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
SPSVCINST_ASSOCSERVICE= 0x00000002
ManufacturerName="<Your manufacturer name>" ;TODO: Replace with your manufacturer name
DiskName = "dummy2 Installation Disk"
dummy2.DeviceDesc = "dummy2 Device"
dummy2.SVCDESC = "dummy2 Service"